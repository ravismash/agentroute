# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=info
PORT=8080
DATABASE_URL=postgres://agentroute:agentroute@localhost:5433/agentroute
REDIS_URL=redis://localhost:6380
OTEL_EXPORTER_OTLP_ENDPOINT=
# Restricted test-mode key (rk_test_...) with refund write + charge read only. Never commit it.
STRIPE_SECRET_KEY=
# LLM for the SupportOps agent: set ONE of these (OpenRouter recommended; set a credit limit on the key).
LLM_PROVIDER=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Optional model override (default for OpenRouter: openai/gpt-5.6-luna)
AGENT_MODEL=
# Phase 5 controls (optional). Rate limiting (gateway) and the LLM budget (agent)
# activate only when REDIS_URL is set; defaults are generous — tune per tenant.
# RATE_LIMIT_PER_KEY_RPS=1000
# RATE_LIMIT_PER_KEY_BURST=2000
# RATE_LIMIT_PER_TENANT_RPS=2000
# RATE_LIMIT_PER_TENANT_BURST=4000
# AGENT_LLM_BUDGET_MINOR=200   # daily LLM spend ceiling for the agent, in minor units
# LLM_EST_COST_MINOR=1         # reserved per model call
