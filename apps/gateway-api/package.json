{
  "name": "@agentroute/gateway-api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify gateway: proposals, policy decisions, approvals, execution",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "node --env-file-if-exists=../../.env --watch dist/server.js",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "seed": "node --env-file-if-exists=../../.env dist/scripts/seed.js",
    "e2e": "node --env-file-if-exists=../../.env dist/scripts/e2e.js",
    "load": "node --env-file-if-exists=../../.env dist/scripts/load.js",
    "redteam": "node --env-file-if-exists=../../.env dist/scripts/redteam.js"
  },
  "dependencies": {
    "@agentroute/approval-ui": "workspace:*",
    "@agentroute/contracts": "workspace:*",
    "@agentroute/db": "workspace:*",
    "@agentroute/execution": "workspace:*",
    "@agentroute/limits": "workspace:*",
    "@agentroute/policy-engine": "workspace:*",
    "@agentroute/telemetry": "workspace:*",
    "fastify": "^5.12.5",
    "redis": "^6.3.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  }
}
