{
  "name": "@agentroute/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Outbox relay, Redis Streams consumers (audit, stats), DLQ/replay, background jobs",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "replay": "node --env-file-if-exists=../../.env dist/replay.js"
  },
  "dependencies": {
    "@agentroute/contracts": "workspace:*",
    "@agentroute/db": "workspace:*",
    "@agentroute/execution": "workspace:*",
    "@agentroute/telemetry": "workspace:*",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.0"
  }
}
